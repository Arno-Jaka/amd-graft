# Stage 8 - LLM endpoint (vLLM on the AMD instance).
# Leave both blank to run Graft with the agent layer disabled. The product
# converts, verifies, benchmarks, and reports without these.
# Graft reads this file at import time; real environment variables win.
LLM_MODEL=
LLM_BASE_URL=

# Optional. A local vLLM server usually needs no auth; Graft supplies a
# placeholder in that case. This is not a credential.
LLM_API_KEY=

# Name of the variable above, if it is not VLLM_API_KEY.
# LLM_API_KEY_ENV=VLLM_API_KEY

# Optional. Seconds allowed for one model call, and the number of tool
# calls the agent may make per request.
# AGENT_TIMEOUT_S=60
# AGENT_MAX_TOOL_CALLS=8

# Set to 0 to disable the agent layer entirely without unsetting the
# endpoint above.
# AGENT_ENABLED=1
