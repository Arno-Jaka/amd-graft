# Stage 8 - AI endpoint (Google Gemma via AMD's Radeon token factory).
# Graft ships a default endpoint, model, and shared demo key so the AI report
# and the "Convert with Google Gemma" action work out of the box. Override any
# of these to point at your own model or to bill your own quota. Graft reads
# this file at import time; real environment variables win.
#
# LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# LLM_MODEL=Gemma-4-31B-IT

# Optional. Overrides the shared demo key. The key is used only to build the
# request and is never written to a report or a log.
# LLM_API_KEY=

# Optional. Seconds allowed for one model call. Enforced on the HTTP request
# itself, so a hung endpoint cannot stall the pipeline.
# AGENT_TIMEOUT_S=60

# Set to 0 to disable the AI layer entirely without unsetting the endpoint
# above. The product still converts, verifies, benchmarks, and reports.
# AGENT_ENABLED=1
